# Anthropic
ANTHROPIC_API_KEY=

# Meta Messenger
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=

# Facebook Graph API (for crawling page posts)
FACEBOOK_PAGE_ACCESS_TOKEN=

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Crawler schedule (24h clock, default: 2:00am)
CRAWL_SCHEDULE_HOUR=2
CRAWL_SCHEDULE_MINUTE=0

# Website chat widget
# Per-IP rate limits on POST /chat
WIDGET_RATE_LIMIT_PER_MINUTE=10
WIDGET_RATE_LIMIT_PER_DAY=150
# Space-separated list of origins allowed to embed /widget in an <iframe>
WIDGET_FRAME_ANCESTORS=https://communityswimclub.com https://www.communityswimclub.com
# Link shown in the widget footer; defaults to the self-hosted copy
PRIVACY_POLICY_URL=/privacy-policy

# Logging
LOG_LEVEL=INFO
